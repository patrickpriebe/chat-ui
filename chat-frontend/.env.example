# REST base URL of chat-api. Compiled into the bundle at build time — public by definition.
VITE_API_URL=http://localhost:8080/api

# SockJS endpoint. Optional: when omitted it is derived from VITE_API_URL by stripping a
# trailing /api and appending /ws. Set it explicitly when the WebSocket endpoint is not a
# sibling of the REST base.
VITE_WS_URL=http://localhost:8080/ws
